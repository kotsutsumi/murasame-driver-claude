{
  "name": "@murasame/driver-claude",
  "version": "0.1.0-rc.1",
  "description": "A process and control driver for headless Claude Code stream-json executions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kotsutsumi/murasame-driver-claude.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "example:hello": "bun run examples/hello.ts",
    "example:tool": "bun run examples/tool.ts",
    "example:subagent": "bun run examples/subagent.ts",
    "example:cancel": "bun run examples/cancel.ts",
    "example:multi-run": "bun run examples/multi-run.ts"
  },
  "dependencies": {
    "@murasame/adapter-claude": "0.1.0-rc.1",
    "@murasame/protocol": "0.1.0-rc.1",
    "@murasame/runtime": "0.1.0-rc.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
